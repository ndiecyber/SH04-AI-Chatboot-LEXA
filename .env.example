# === Groq API ===
GROQ_API_KEY=gsk_tu_api_key_anda_sini
MODEL_NAME=openai/gpt-oss-120b

# === RAG Pipeline ===
KNOWLEDGE_BASE_DIR=knowledge_base
VECTOR_INDEX_PATH=knowledge_base/vector_index.pkl
KNOWLEDGE_BASE_URL=https://sh-01-company-profile.vercel.app/api/knowledge-base
EMBEDDING_MODEL=all-MiniLM-L6-v2

# === Chat ===
MAX_HISTORY_TURNS=10
RAG_TOP_K=5
RAG_THRESHOLD=0.22
MAX_INPUT_LENGTH=2000

# === API Server ===
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# === Widget ===
WELCOME_MESSAGE=Halo! 👋 Saya Lexa, asisten customer service LEXA Software House. Ada yang bisa saya bantu?

# === Security ===
# Generate secure secret: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=lexa-dev-secret-key-change-in-production

# === Admin ===
ADMIN_EMAIL=admin@lexatech.id
ADMIN_PASSWORD=  # Biarkan kosong untuk auto-generate password saat startup pertama

# === Optional: Additional Settings ===
# WELCOME_MESSAGE bisa dioverride di Settings Dashboard

# === Database ===
DATABASE_URL=postgresql://postgres:password@localhost:5432/lexa_db